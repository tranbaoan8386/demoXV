# Example environment variables for legal-uploader
# Do NOT store real secrets here. Copy to .env and fill values.

# Server
PORT=8083

# PostgreSQL (dedicated DB for legal-uploader)
DATABASE_URL=postgresql://demoxv_admin:demoxv_secret_pass@demoxv-postgres:5432/legal_db

# MinIO (dedicated object storage)
MINIO_ENDPOINT=demoxv-minio:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secret_pass
MINIO_BUCKET=legal-documents
MINIO_USE_SSL=false

# Local upload directory on the host (used by Docker Compose volume mapping)
# Example: ./uploads or /var/lib/legal-uploader/uploads
UPLOAD_DIR=./uploads

# JWT
JWT_SECRET_KEY=change_this_to_a_secure_random_value
